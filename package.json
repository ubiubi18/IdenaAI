{
  "name": "idena-ai",
  "productName": "IdenaAI",
  "version": "0.1.0",
  "description": "Idena desktop fork with optional experimental AI flip tooling and benchmark helpers.",
  "main": "main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ubiubi18/IdenaAI.git"
  },
  "homepage": "https://github.com/ubiubi18/IdenaAI#readme",
  "bugs": {
    "url": "https://github.com/ubiubi18/IdenaAI/issues"
  },
  "author": "ubiubi18",
  "license": "MIT",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-runtime-install.js",
    "postinstall": "node scripts/rebuild-electron-runtime-deps.js",
    "start": "node --env-file-if-exists=.env.local scripts/start-electron-dev.js",
    "doctor": "node scripts/source-doctor.js",
    "setup:sources": "node scripts/setup-sources.js",
    "update:sources": "node scripts/setup-sources.js --update",
    "setup:flips": "node scripts/setup-flips.js",
    "build:node": "node scripts/build-node-from-sources.js",
    "build:social": "npm ci --prefix vendor/idena.social-ui && npm run build --prefix vendor/idena.social-ui && node scripts/sync-idena-social-ui.js",
    "build:renderer": "node scripts/run-next-static-build.js",
    "build": "npm run build:social && npm run build:renderer",
    "dist": "npm run build && node scripts/run-electron-builder.js",
    "dist:win": "npm run build && node scripts/run-electron-builder.js --win --publish onTag",
    "dist:mac": "npm run build && node scripts/run-electron-builder.js --mac --publish onTag",
    "dist:mac:arm64": "npm run build && node scripts/run-electron-builder.js --mac --arm64 --publish onTag",
    "dist:mac:universal": "npm run build && node scripts/run-electron-builder.js --mac --universal --publish onTag",
    "dist:linux": "npm run build && node scripts/run-electron-builder.js --linux --publish onTag",
    "pack": "npm run build && node scripts/run-electron-builder.js --dir",
    "pack:mac:arm64": "npm run build && node scripts/run-electron-builder.js --dir --mac --arm64",
    "pack:mac:universal": "npm run build && node scripts/run-electron-builder.js --dir --mac --universal",
    "clean": "node scripts/clean-paths.js renderer/out renderer/.next dist",
    "audit:privacy": "node scripts/check-release-privacy.js",
    "audit:metadata": "node scripts/check-release-metadata.js",
    "audit:artifacts": "node scripts/check-release-artifacts.js",
    "audit:deps": "node scripts/check-dependency-footprint.js",
    "audit:electron": "node scripts/check-electron-safety.js",
    "audit:compatibility": "node scripts/check-compatibility-lock.js",
    "audit:local-ai-model-licenses": "node scripts/audit-local-ai-model-licenses.js",
    "build:node:mac:arm64": "npm run setup:sources && node scripts/build-node-from-sources.js \"$HOME/Library/Application Support/IdenaAI/node/idena-go\" --platform darwin --arch arm64",
    "release:check": "node scripts/release-check.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:local-rag": "jest main/local-rag --runInBand",
    "test:source-rag": "jest main/source-rag --runInBand",
    "test:qwen-deepinfra": "node scripts/run_deepinfra_qwen_test_unit.js",
    "prepare:qwen-flip-draft": "node scripts/prepare_qwen_flip_draft.js",
    "rag:demo": "node scripts/local-rag-demo.js",
    "rag:source-env": "node scripts/source-rag-test-env.js",
    "test:idena-go:validation": "idena-go/scripts/run-go-toolchain.sh test ./config ./database ./api ./core/ceremony",
    "test:idena-go:wasm": "idena-go/scripts/run-go-toolchain.sh test ./vm/wasm -count=1",
    "index:deep-research": "node scripts/run-python.js scripts/build_deep_research_index.py",
    "ipfs:inspect": "node scripts/run-python.js scripts/ipfs_inspector.py",
    "ipfs:inspect:offline": "bash scripts/ipfs-offline-inspector.sh",
    "playwright:close": "bash scripts/close-playwright-browser.sh",
    "i18n:init": "npm run i18n:clean && npm run i18n:scan",
    "i18n:scan": "i18next-scanner",
    "i18n:clean": "node scripts/clean-paths.js locales/en locales/id locales/fr locales/de locales/es locales/ru locales/zh locales/ko locales/hr locales/hi locales/ro locales/uk locales/sr locales/it locales/pt locales/pl locales/si locales/tr locales/bg locales/sv locales/ja locales/el",
    "e2e": "node scripts/e2e-disabled.js"
  },
  "build": {
    "appId": "io.idena.ai",
    "artifactName": "idena-ai-${os}-${version}.${ext}",
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "ubiubi18",
        "repo": "IdenaAI",
        "releaseType": "release"
      }
    ],
    "files": [
      "**/*",
      "!**/.env",
      "!**/.env.*",
      "!**/*.log",
      "!.tmp",
      "!.tmp/**",
      "!tmp",
      "!tmp/**",
      "!data",
      "!data/**",
      "!logs",
      "!logs/**",
      "!build",
      "!build/**",
      "!dist",
      "!dist/**",
      "!coverage",
      "!coverage/**",
      "!.nyc_output",
      "!.nyc_output/**",
      "!vendor",
      "!vendor/**",
      "!idena-go",
      "!idena-go/**",
      "!idena-wasm",
      "!idena-wasm/**",
      "!idena-wasm-binding",
      "!idena-wasm-binding/**",
      "!samples/flips/flip-challenge-human-teacher-500-balanced.part-*.json",
      "!docs",
      "!docs/**",
      "!test",
      "!test/**",
      "!output",
      "!output/**",
      "!.playwright-cli",
      "!.playwright-cli/**",
      "!.vscode",
      "!.vscode/**",
      "!downloads",
      "!downloads/**",
      "!renderer",
      "renderer/out"
    ],
    "protocols": {
      "name": "idena",
      "schemes": [
        "dna"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "main/static/icons/icon-512@2x.icns",
      "extraResources": [
        {
          "from": "build/node/current",
          "to": "node"
        }
      ]
    },
    "win": {
      "icon": "main/static/icons/icon_512_2x.ico",
      "extraResources": [
        {
          "from": "build/node/current",
          "to": "node"
        }
      ]
    },
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "main/static/icons/icon-512@2x.icns",
      "maintainer": "Idena <info@idena.io> (https://idena.io/)",
      "extraResources": [
        {
          "from": "build/node/current",
          "to": "node"
        }
      ]
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@electron/rebuild": "^4.2.0",
    "babel-jest": "^29.7.0",
    "cors": "^2.8.5",
    "electron": "43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.36.0",
    "eslint-config-wesbos": "^3.2.3",
    "express": "^4.17.1",
    "i18next-scanner": "^2.10.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "next": "^16.2.10",
    "prettier": "^2.8.7",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@chakra-ui/react": "^1.0.0",
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@xstate/react": "^3.2.1",
    "ansi-to-react": "^6.2.6",
    "canvas-confetti": "^1.4.0",
    "color-convert": "^2.0.1",
    "dayjs": "^1.9.6",
    "dequal": "^1.0.0",
    "dexie": "^3.2.2",
    "electron-updater": "^6.8.9",
    "extract-colors": "^1.1.22",
    "framer-motion": "^4.0.0",
    "fs-extra": "^8.1.0",
    "google-protobuf": "^3.14.0",
    "i18next": "^19.0.1",
    "js-sha3": "^0.8.0",
    "leveldown": "^5.6.0",
    "levelup": "^4.4.0",
    "lowdb": "^1.0.0",
    "mousetrap": "^1.6.3",
    "multiformats": "^9.7.1",
    "nanoid": "^3.3.11",
    "pino": "^5.13.2",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "@hello-pangea/dnd": "^18.0.1",
    "react-i18next": "^11.2.5",
    "react-query": "^3.39.0",
    "react-scroll": "^1.8.7",
    "react-swipeable": "^7.0.0",
    "rlp": "^2.2.2",
    "semver": "^7.7.2",
    "stackblur-canvas": "^2.5.0",
    "subleveldown": "^5.0.1",
    "tree-kill": "^1.2.2",
    "url-regex-safe": "^3.0.0",
    "xstate": "^4.37.1"
  },
  "overrides": {
    "@babel/runtime": "^7.26.10",
    "@babel/runtime-corejs3": "^7.26.10",
    "@tootallnate/once": "^3.0.1",
    "braces": "^3.0.3",
    "browserslist": "^4.26.3",
    "elliptic": {
      ".": "^6.6.1",
      "bn.js": "4.12.3"
    },
    "linkify-it": "^5.0.1",
    "loader-utils": "^2.0.4",
    "minimatch": "^3.1.5",
    "node-abi": "^4.33.0",
    "node-fetch": "^2.7.0",
    "object-path": "^0.11.8",
    "postcss": "^8.5.10",
    "serialize-javascript": "^7.0.5",
    "shell-quote": "^1.8.3",
    "tar": "^7.5.13",
    "terser": "^4.8.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "fsevents": false,
    "leveldown@5.6.0": true,
    "sharp@0.34.5": true
  },
  "prettier": {
    "trailingComma": "es5",
    "semi": false,
    "singleQuote": true,
    "bracketSpacing": false
  }
}
