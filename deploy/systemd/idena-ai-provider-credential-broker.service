[Unit]
Description=IdenaAI host-bound provider credential broker
After=local-fs.target
Before=idena-ai-console.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/
ExecStartPre=/usr/bin/install -d -m 0700 -o root -g root /etc/credstore.encrypted
ExecStart=/usr/bin/python3 /usr/local/libexec/idena-ai/provider-credential-broker.py
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
RuntimeDirectory=idena-ai
RuntimeDirectoryMode=0755
UMask=0077

Environment=IDENA_AI_CREDENTIAL_USER=pohw
Environment=IDENA_AI_CREDENTIAL_ALLOWED_CGROUP=/system.slice/idena-ai-console.service
Environment=IDENA_AI_CREDENTIAL_SOCKET=/run/idena-ai/provider-credentials.sock
Environment=IDENA_AI_OPENAI_CREDENTIAL=/etc/credstore.encrypted/idena-ai-openai-api-key.cred

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RemoveIPC=yes
LockPersonality=yes
KeyringMode=private
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_CHOWN
AmbientCapabilities=CAP_CHOWN
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/etc/credstore.encrypted /run/idena-ai

[Install]
WantedBy=multi-user.target
