# Copy this file to .env.local for local development.
# Do not commit .env.local or provider API keys.

# Main provider defaults. API keys are loaded in the app UI as session-only keys.
IDENAAI_PROVIDER_DEFAULT=openai
IDENAAI_OPENAI_MODEL=gpt-5.5
IDENAAI_GEMINI_MODEL=gemini-2.0-flash

# Optional Python 3.11+ story pipeline. Keep disabled unless requirements.txt is installed.
IDENAAI_USE_PY_FLIP_PIPELINE=false
# Executable paths may contain spaces; Windows also accepts py -3 or py -3.11.
# Empty uses the platform default.
IDENAAI_PYTHON=

# Managed node runtime. Source builds use the pinned ubiubi18 source mirrors.
# Add extra comma-separated release repos only if you intentionally trust them.
IDENAAI_NODE_SOURCE_BUILD=true
IDENAAI_NODE_RELEASE_REPOS=ubiubi18/idena-go
IDENAAI_NODE_DISABLE_REMOTE_DOWNLOAD=false

# Benchmark logging controls.
IDENAAI_BENCH_LOGGING=true
IDENAAI_BENCH_LOG_MAX_MB=200
